# Runtime
PORT=
NODE_ENV=
APP_VERSION=
APP_WEB_URL=
CORS_ORIGINS=

# Authentication v1
AUTH_V1_ENABLED=false
LEGACY_AUTH_ENABLED=false
JWT_SECRET=

# MySQL — internal network only
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# SMTP — required when AUTH_V1_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Feature flags
FEATURE_CHATBOT=false
FEATURE_ANALYTICS=false
