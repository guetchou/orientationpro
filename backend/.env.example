# Runtime
PORT=
NODE_ENV=
APP_VERSION=
APP_WEB_URL=
CORS_ORIGINS=

# Authentication v1
AUTH_V1_ENABLED=false
LEGACY_AUTH_ENABLED=false
JWT_SECRET=

# MySQL — internal network only
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# SMTP — required when AUTH_V1_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Orientation RIASEC
# Requires AUTH_V1_ENABLED=true, migration 002 and `npm run seed:riasec`.
RIASEC_API_ENABLED=false
# Development/pilot only. Keep false until the draft instrument is reviewed.
RIASEC_ALLOW_DRAFT=false

# Career catalog and occupation matching
# Requires AUTH_V1_ENABLED=true and migrations 003-004.
CAREER_API_ENABLED=false
# Pinned source release. Import is explicit; it never runs on API startup.
ONET_VERSION=30.3
ONET_BASE_URL=https://www.onetcenter.org/dl_files/database/db_30_3_json
ONET_MIN_OCCUPATIONS=1000
ONET_MIN_DIRECT_PROFILES=900
# Resilient downloads: IPv4 preference, retry/backoff and optional validated local cache.
ONET_FORCE_IPV4=true
ONET_DOWNLOAD_ATTEMPTS=4
ONET_DOWNLOAD_TIMEOUT_MS=180000
ONET_CACHE_DIR=
# Keep false. Enable only after reviewing a changed source hash for the same pinned release.
ALLOW_SOURCE_REPLACE=false

# Feature flags
FEATURE_CHATBOT=false
FEATURE_ANALYTICS=false
