# Runtime
PORT=
NODE_ENV=
APP_VERSION=
APP_WEB_URL=
CORS_ORIGINS=

# Authentication v1
AUTH_V1_ENABLED=false
LEGACY_AUTH_ENABLED=false
JWT_SECRET=
# Social authentication — migration 007 required. Never commit real secrets.
OAUTH_CALLBACK_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Explicitly pin a supported Meta Graph API version, for example v23.0.
META_GRAPH_API_VERSION=

# MySQL — internal network only
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# Legacy API surfaces — unsafe until individually migrated and authorized.
# Keep false. This controls CV, candidates, jobs, ATS, appointments, messaging,
# applications, matching, communication and scraping routes outside /api/v1.
LEGACY_API_ENABLED=false

# Request and resource limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_EXPENSIVE_MAX=60
# Optional 32+ byte secret. If absent, an ephemeral process-local key is generated.
RATE_LIMIT_KEY_SECRET=
JSON_BODY_LIMIT=1mb
URLENCODED_PARAMETER_LIMIT=200

# Data rights API — export, correction and account deletion.
# Requires AUTH_V1_ENABLED=true. Keep false until legal review and MySQL E2E validation.
DATA_RIGHTS_API_ENABLED=false

# SMTP — required when AUTH_V1_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Parcours MAKOKI / projet de vie
# Requires AUTH_V1_ENABLED=true and migration 011. Experimental API only; no frontend activation.
LIFE_PROJECT_API_ENABLED=false

# Orientation RIASEC
# Requires AUTH_V1_ENABLED=true, migration 002 and `npm run seed:riasec`.
RIASEC_API_ENABLED=false
# Development/pilot only. Keep false until the draft instrument is reviewed.
RIASEC_ALLOW_DRAFT=false

# Career catalog and occupation matching
# Requires AUTH_V1_ENABLED=true and migrations 003-004.
CAREER_API_ENABLED=false

# CV optimizer API v1
# Requires AUTH_V1_ENABLED=true and migration 005.
CV_API_V1_ENABLED=false
# Optional absolute directory for temporary uploads.
CV_UPLOAD_DIR=
# Pinned source release. Import is explicit; it never runs on API startup.
ONET_VERSION=30.3
ONET_BASE_URL=https://www.onetcenter.org/dl_files/database/db_30_3_json
ONET_MIN_OCCUPATIONS=1000
ONET_MIN_DIRECT_PROFILES=900
# Resilient downloads: IPv4 preference, retry/backoff and optional validated local cache.
ONET_FORCE_IPV4=true
ONET_DOWNLOAD_ATTEMPTS=4
ONET_DOWNLOAD_TIMEOUT_MS=180000
ONET_CACHE_DIR=
# Keep false. Enable only after reviewing a changed source hash for the same pinned release.
ALLOW_SOURCE_REPLACE=false

# Feature flags
FEATURE_CHATBOT=false
FEATURE_ANALYTICS=false
