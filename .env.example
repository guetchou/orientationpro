# Web application
VITE_API_URL=http://localhost:3000/api
VITE_BACKEND_URL=http://localhost:3000
NODE_ENV=development

# Optional non-essential trackers.
# Leave empty to keep the provider disabled.
# Even when configured, these scripts are loaded only after the user grants consent.
VITE_GOOGLE_ANALYTICS_ID=
VITE_META_PIXEL_ID=

# Explicit ESCO French catalogue import. This command is never run at API startup.
ESCO_VERSION=1.2.1
ESCO_LOCALE=fr
# Provide either the official ZIP/CSV package path or its one-time official download URL.
ESCO_ARCHIVE_PATH=
ESCO_ARCHIVE_URL=
# Optional local copy of the official European Commission O*NET–ESCO crosswalk.
ESCO_CROSSWALK_PATH=
ESCO_CROSSWALK_URL=https://esco.ec.europa.eu/system/files/2023-08/ONET_%28Occupations%29_0_updated.csv
ESCO_CACHE_DIR=.cache/esco
ESCO_MIN_OCCUPATIONS=2900
ESCO_MIN_SKILLS=13000
ESCO_MIN_CROSSWALKS=1000
ESCO_DOWNLOAD_ATTEMPTS=4
ESCO_DOWNLOAD_TIMEOUT_MS=180000
ESCO_ACCESS_DATE=

# Analyse CV V1. Active le parcours d’import et d’analyse côté web.
# Nécessite CV_API_V1_ENABLED=true côté API et un rebuild du service web.
VITE_CV_ANALYSIS_ENABLED=false

# Parcours post-bac (lot auto-orientation V1). Route /post-bac masquee si false.
VITE_POSTBAC_AUTO_V1_ENABLED=false
# Parcours candidat ATS V1 (issue #198). Routes /offres et /mes-candidatures
# masquees si false. Necessite aussi ATS_WORKFLOW_V1_ENABLED cote backend.
VITE_ATS_CANDIDATE_ENABLED=false
# Interface recruteur ATS V1 (issue #199). Routes /recruteur/ats/... masquees
# si false. Necessite aussi ATS_WORKFLOW_V1_ENABLED cote backend.
VITE_ATS_RECRUITER_ENABLED=false
# Canaux conseiller facultatifs (WhatsApp prioritaire, sinon formulaire).
VITE_MAKOKI_ADVISOR_WHATSAPP=
VITE_MAKOKI_ADVISOR_FORM_URL=
